# ---------------------------------------------------------------------------
# Quizora — RAG based study assistant backend configuration
# Copy this file to backend/.env and adjust values for your machine.
# All values can also be provided as environment variables.
# ---------------------------------------------------------------------------

# Which LLM mode to use by default when a request does not specify one.
# Supported: local | gemini
DEFAULT_LLM_MODE=local

# --- Ollama (local mode) ---------------------------------------------------
# Base URL of the Ollama HTTP server.
OLLAMA_BASE_URL=http://localhost:11434
# Generation model. Pull it first with: ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct
# Embedding model. Pull it first with: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Gemini (cloud mode) ---------------------------------------------------
# Never commit a real key. Leave empty to disable Gemini mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Storage ---------------------------------------------------------------
# Local SQLite database (swap with a Postgres URL if needed).
DATABASE_URL=sqlite:///./data/quizora.db
# Persistent ChromaDB directory (vector store).
CHROMA_DIR=./data/chroma
# Maximum upload size in MB.
MAX_UPLOAD_MB=50

# --- LLM behaviour ---------------------------------------------------------
# Per-request timeout for a single LLM call (seconds). Raise on slow CPU-only
# machines if long generations time out.
LLM_TIMEOUT_SECONDS=180
# How many times structured (JSON) generation is retried before failing.
LLM_MAX_JSON_ATTEMPTS=3

# --- HTTP / CORS -----------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL prefix for all API routes.
API_PREFIX=/api
